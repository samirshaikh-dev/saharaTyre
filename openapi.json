  "components": {
    "schemas": {
      "BusinessProfile": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Sahara Tyre GIDC Vapi"
          },
          "establishedYear": {
            "type": "integer",
            "example": 2005
          },
          "streetAddress": {
            "type": "string",
            "example": "Shop No 07, Amidhara Complex, Char Rasta, near CNG Pump, Phase 1, GIDC"
          },
          "addressLocality": {
            "type": "string",
            "example": "Vapi"
          },
          "addressRegion": {
            "type": "string",
            "example": "Gujarat"
          },
          "postalCode": {
            "type": "string",
            "example": "396195"
          },
          "addressCountry": {
            "type": "string",
            "example": "IN"
          },
          "geo": {
            "type": "object",
            "properties": {
              "latitude": {
                "type": "number",
                "example": 20.362324
              },
              "longitude": {
                "type": "number",
                "example": 72.919686
              },
              "plusCode": {
                "type": "string",
                "example": "9669+V7 Vapi, Gujarat"
              }
            }
          },
          "telephone": {
            "type": "string",
            "example": "+91-9377158216"
          },
          "whatsapp": {
            "type": "string",
            "example": "https://wa.me/919377158216"
          },
          "email": {
            "type": "string",
            "example": "shaikh.samir.dev@gmail.com"
          },
          "openingHours": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "Mo-Sa 07:30-21:00 IST",
              "Su 07:30-18:00 IST"
            ]
          },
          "aggregateRating": {
            "type": "object",
            "properties": {
              "ratingValue": {
                "type": "number",
                "example": 4.8
              },
              "reviewCount": {
                "type": "integer",
                "example": 120
              },
              "bestRating": {
                "type": "number",
                "example": 5.0
              }
            }
          }
        }
      },
      "ServiceItem": {
        "type": "object",
        "properties": {
          "serviceId": {
            "type": "string",
            "example": "wheel-alignment-vapi"
          },
