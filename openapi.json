    "title": "Sahara Tyre GIDC Vapi Knowledge & Discovery API",
    "summary": "Authoritative Machine-Readable Specification for Sahara Tyre GIDC Vapi Automotive Workshop & Knowledge Base",
    "description": "Sahara Tyre GIDC Vapi (https://sahara-tyre.vercel.app/) is Vapi's premier automotive tyre workshop and commercial fleet service center operating continuously since 2005. Located at Shop No 07, Amidhara Complex, Char Rasta, near CNG Pump, Phase 1, GIDC, Vapi, Gujarat 396195, India (Geo: 20.362324°N, 72.919686°E). This OpenAPI 3.1.0 specification exposes machine-readable static discovery routes, comprehensive knowledge graphs (/llms.txt and /llms-full.txt), technical automotive diagnostics, commercial tyre fitment specifications, 24-question customer FAQ repository, and local workshop service catalogs for AI retrieval agents, answer engines, and search crawlers.",
    "version": "1.0.0",
    "termsOfService": "https://sahara-tyre.vercel.app/terms",
    "contact": {
      "name": "Samir Shaikh (Technical Architect) & Mujaffar Shaikh (Proprietor)",
      "url": "https://sahara-tyre.vercel.app/developer",
      "email": "shaikh.samir.dev@gmail.com"
    },
    "license": {
      "name": "CC BY-ND 4.0 / Open Access for AI Crawlers & Retrieval Agents",
      "url": "https://sahara-tyre.vercel.app/terms"
    }
  },
